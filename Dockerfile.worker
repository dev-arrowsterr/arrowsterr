# The Arrowsterr job worker. It calls the app's /api/worker, and prints report PDFs with Chromium.
# The Playwright image brings Chromium and its fonts; playwright-core must match its version.
FROM mcr.microsoft.com/playwright:v1.56.1-noble
ENV NODE_ENV=production
WORKDIR /app
RUN npm init -y >/dev/null && npm install --no-audit --no-fund playwright-core@1.56.1
COPY scripts/worker.mjs ./worker.mjs
USER pwuser
CMD ["node", "worker.mjs"]
